<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono de la app: fondo completamente blanco y el logo dorado del gimnasio
     centrado. Es adaptativo, así cada celular lo recorta con su forma (círculo,
     cuadrado redondeado…) sin cortar el logo. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground android:drawable="@drawable/ic_launcher_logo" />
    <monochrome android:drawable="@drawable/ic_launcher_logo" />
</adaptive-icon>
