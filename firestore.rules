rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Dietas: los socios solo leen platos ya publicados por el empleado.
    // Nadie escribe desde el cliente — solo el Admin SDK (empleados) lo hace.
    match /dietas/{platoId} {
      allow read: if resource.data.publicado == true;
      allow write: if false;
    }

    // Ejercicios: mismo criterio que dietas.
    match /ejercicios/{ejercicioId} {
      allow read: if resource.data.publicado == true;
      allow write: if false;
    }

    // Marcas: cualquier socio autenticado puede leer todas (hace falta para
    // el ranking de Clasificación), pero solo puede crear o borrar marcas
    // propias (socio_id == su uid de Firebase Auth) — borrar la de otro
    // socio queda prohibido. Verificar/rechazar una marca lo hace un
    // empleado desde el Admin SDK, que no pasa por estas reglas.
    match /marcas/{marcaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.socio_id == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.socio_id == request.auth.uid;
      allow update: if false;
    }

    // Socios_app: nombre y fecha de alta de cada acceso (lo crea un
    // empleado, ver auth_repo.py). Se lee para mostrar "socio hace X" en la
    // Escalera del Olimpo — nunca se escribe desde el cliente.
    match /socios_app/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Datos físicos: a diferencia de socios_app, esto SÍ lo escribe el
    // propio socio (peso/edad/sexo/experiencia del onboarding obligatorio)
    // — solo sobre su propio documento. Se puede leer en general porque los
    // rangos de la Escalera del Olimpo se calculan contra el peso de cada
    // uno, y el perfil de un socio en Clasificación muestra ese dato.
    match /datos_fisicos/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Socios_privado: el DNI de cada socio (lo carga un empleado al crear
    // el acceso, ver auth_repo.py). A diferencia de socios_app, esto NO se
    // puede leer de cualquier socio a otro — un DNI es un dato demasiado
    // sensible para dejarlo abierto a todo el club. Cada socio solo puede
    // leer su propio documento; el sistema de empleados lo lee entero
    // porque el Admin SDK no pasa por estas reglas.
    match /socios_privado/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Series de entrenamiento: cada serie que un socio registra en una
    // rutina de Entrenar (no una marca de la Calculadora — ver marcas_repo
    // y EntrenamientoRepository.kt). A diferencia de "marcas", nadie las
    // verifica: alimentan "kg movidos este mes" y el Ghost Mode, no el
    // ranking de Clasificación. Cada socio solo lee/crea las propias.
    match /series_entrenamiento/{serieId} {
      allow read: if request.auth != null && resource.data.socio_id == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.socio_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Cualquier otra colección: denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
