rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Dietas: los socios solo leen platos ya publicados por el empleado.
    // Nadie escribe desde el cliente — solo el Admin SDK (empleados) lo hace.
    match /dietas/{platoId} {
      allow read: if resource.data.publicado == true;
      allow write: if false;
    }

    // Ejercicios: mismo criterio que dietas.
    match /ejercicios/{ejercicioId} {
      allow read: if resource.data.publicado == true;
      allow write: if false;
    }

    // Marcas: cualquier socio autenticado puede leer todas (hace falta para
    // el ranking de Clasificación), pero solo puede crear o borrar marcas
    // propias (socio_id == su uid de Firebase Auth) — borrar la de otro
    // socio queda prohibido. Verificar/rechazar una marca lo hace un
    // empleado desde el Admin SDK, que no pasa por estas reglas.
    match /marcas/{marcaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.socio_id == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.socio_id == request.auth.uid;
      allow update: if false;
    }

    // Socios_app: nombre y fecha de alta de cada acceso (lo crea un
    // empleado, ver auth_repo.py). Se lee para mostrar "socio hace X" en la
    // Escalera del Olimpo. La única escritura permitida desde el cliente es
    // que el propio socio apague "debe_cambiar_password" (nunca lo prenda)
    // después de elegir su contraseña nueva en el primer login (ver
    // CambiarPasswordScreen.kt) — sin tocar ningún otro campo del documento.
    match /socios_app/{uid} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['debe_cambiar_password'])
                    && request.resource.data.debe_cambiar_password == false;
      allow create, delete: if false;
    }

    // Datos físicos: a diferencia de socios_app, esto SÍ lo escribe el
    // propio socio (peso/edad/sexo/experiencia del onboarding obligatorio)
    // — solo sobre su propio documento. Se puede leer en general porque los
    // rangos de la Escalera del Olimpo se calculan contra el peso de cada
    // uno, y el perfil de un socio en Clasificación muestra ese dato.
    match /datos_fisicos/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Socios_privado: el DNI de cada socio (lo carga un empleado al crear
    // el acceso, ver auth_repo.py). A diferencia de socios_app, esto NO se
    // puede leer de cualquier socio a otro — un DNI es un dato demasiado
    // sensible para dejarlo abierto a todo el club. Cada socio solo puede
    // leer su propio documento; el sistema de empleados lo lee entero
    // porque el Admin SDK no pasa por estas reglas.
    match /socios_privado/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Series de entrenamiento: cada serie que un socio registra en una
    // rutina de Entrenar (no una marca de la Calculadora — ver marcas_repo
    // y EntrenamientoRepository.kt). A diferencia de "marcas", nadie las
    // verifica: alimentan "kg movidos este mes" y el Ghost Mode, no el
    // ranking de Clasificación. Cada socio solo lee/crea las propias.
    match /series_entrenamiento/{serieId} {
      allow read: if request.auth != null && resource.data.socio_id == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.socio_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Ingresos: el propio socio marca su asistencia (no hay lector físico
    // conectado todavía — ver IngresoRepository.kt). Solo lee/crea los
    // propios; no se puede editar ni borrar un ingreso ya marcado.
    match /ingresos/{ingresoId} {
      allow read: if request.auth != null && resource.data.socio_id == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.socio_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Reservas de clase: el propio socio reserva un lugar en una clase de
    // la semana (ver ClasesRepository.kt) — solo lee/crea las propias.
    match /reservas_clase/{reservaId} {
      allow read: if request.auth != null && resource.data.socio_id == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.socio_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Rutinas asignadas: la arma un entrenador/dueño desde el sistema de
    // empleados (Admin SDK, no pasa por estas reglas — ver rutinas_repo.py),
    // un documento por socio (id = su uid). El socio solo la lee, nunca la
    // escribe desde la app móvil.
    match /rutinas_asignadas/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Lockers: un documento por socio (id = su uid), el locker que tiene
    // reservado (ver LockersRepository.kt). Cualquier socio autenticado
    // puede LEER todas para saber qué números están libres/ocupados por
    // otro, pero solo puede crear/editar/borrar su propio documento.
    match /lockers/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Perfiles nutricionales: preferencias/exclusiones que carga el propio
    // socio en Nutrición (ver NutricionRepository.kt) — solo lee/escribe
    // su propio documento, nadie más lo necesita.
    match /perfiles_nutricionales/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Membresías: la asigna un empleado desde el sistema de empleados
    // (Admin SDK, no pasa por estas reglas — ver membresias_repo.py), un
    // documento por socio (id = su uid). El socio solo la lee, nunca la
    // escribe desde la app móvil (ya no se auto-asigna un plan tocando un
    // botón).
    match /membresias/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Platos probados: el socio marca "ya probé este plato" (ver
    // PlatosProbadosRepository.kt) — id del documento = "{uid}_{plato_id}",
    // así marcarlo dos veces no duplica. Solo lee/crea los propios.
    match /platos_probados/{docId} {
      allow read: if request.auth != null && resource.data.socio_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.socio_id == request.auth.uid;
      // update: el id fijo "{uid}_{plato_id}" hace que volver a marcar el
      // mismo plato sea un set() sobre un doc ya existente (una
      // actualización, no una creación, para las reglas de Firestore) —
      // solo sobre un documento que ya era propio.
      allow update: if request.auth != null
                    && resource.data.socio_id == request.auth.uid
                    && request.resource.data.socio_id == request.auth.uid;
      allow delete: if false;
    }

    // Registros de agua: el socio marca "hoy tomé agua" (ver
    // AguaRepository.kt) — mismo criterio que ingresos.
    match /registros_agua/{registroId} {
      allow read: if request.auth != null && resource.data.socio_id == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.socio_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Fotos de progreso: guardadas como texto Base64 adentro del propio
    // documento (sin Firebase Storage, ver FotosProgresoRepository.kt) —
    // el socio solo lee/crea/borra las propias.
    match /fotos_progreso/{fotoId} {
      allow read: if request.auth != null && resource.data.socio_id == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.socio_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.socio_id == request.auth.uid;
      allow update: if false;
    }

    // Compañeros de entrenamiento: unidireccional (lo agrega quien lo ve
    // en Clasificación, sin que el otro socio tenga que aceptar nada — ver
    // CompanerosRepository.kt) — un documento por par, id = "{miUid}_{elOtroUid}".
    // Cada socio solo lee/crea/borra su propia lista, nunca la de otro.
    match /companeros/{docId} {
      allow read: if request.auth != null && resource.data.socio_id == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.socio_id == request.auth.uid
                    && request.resource.data.companero_id != request.auth.uid;
      allow delete: if request.auth != null && resource.data.socio_id == request.auth.uid;
      allow update: if false;
    }

    // Configuración de la app (por ahora, solo la base de conocimiento de
    // Argos — ver argos_repo.py). La edita el dueño/admin desde el sistema
    // de empleados (Admin SDK, no pasa por estas reglas); la app móvil y el
    // Worker de Argos solo la leen.
    match /configuracion_app/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Contactos web: lo que llega desde el formulario de "Contacto" de la
    // página pública (Paginas/OlimpOS Landing.html) — quien lo completa
    // todavía no es socio, así que no hay auth.uid para exigir, a
    // diferencia de todo lo demás en este archivo. Por eso solo se permite
    // crear (nunca leer/editar/borrar desde el cliente, ni siquiera el
    // propio mensaje — evita que cualquiera vacíe o lea la bandeja), y se
    // valida la forma exacta del documento para frenar la basura
    // automatizada más obvia. Esto no es una defensa real contra spam
    // (para eso hace falta App Check); es la misma barrera liviana que ya
    // se usa en el resto del proyecto.
    match /contactos_web/{docId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['nombre', 'contacto', 'mensaje', 'creado'])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && request.resource.data.nombre.size() < 100
                    && request.resource.data.contacto is string
                    && request.resource.data.contacto.size() > 0
                    && request.resource.data.contacto.size() < 150
                    && request.resource.data.mensaje is string
                    && request.resource.data.mensaje.size() < 1000;
    }

    // Cualquier otra colección: denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
