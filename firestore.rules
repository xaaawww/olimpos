rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Dietas: los socios solo leen platos ya publicados por el empleado.
    // Nadie escribe desde el cliente — solo el Admin SDK (empleados) lo hace.
    match /dietas/{platoId} {
      allow read: if resource.data.publicado == true;
      allow write: if false;
    }

    // Ejercicios: mismo criterio que dietas.
    match /ejercicios/{ejercicioId} {
      allow read: if resource.data.publicado == true;
      allow write: if false;
    }

    // Marcas: cualquier socio autenticado puede leer todas (hace falta para
    // el ranking de Clasificación), pero solo puede crear marcas propias
    // (socio_id == su uid de Firebase Auth). Verificar/rechazar una marca lo
    // hace un empleado desde el Admin SDK, que no pasa por estas reglas.
    match /marcas/{marcaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.socio_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Socios_app: nombre y fecha de alta de cada acceso (lo crea un
    // empleado, ver auth_repo.py). Se lee para mostrar "socio hace X" en la
    // Escalera del Olimpo — nunca se escribe desde el cliente.
    match /socios_app/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Datos físicos: a diferencia de socios_app, esto SÍ lo escribe el
    // propio socio (peso/edad/sexo/experiencia del onboarding obligatorio)
    // — solo sobre su propio documento. Se puede leer en general porque los
    // rangos de la Escalera del Olimpo se calculan contra el peso de cada
    // uno, y el perfil de un socio en Clasificación muestra ese dato.
    match /datos_fisicos/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Cualquier otra colección: denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
